<Window x:Class="RobbyCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [AppTitle]}"
        Icon="robben.png"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E5E7EB"/>

        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>

        <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBorder" Color="#D1D5DB"/>

        <SolidColorBrush x:Key="ButtonBackground" Color="#0067C0"/>
        <SolidColorBrush x:Key="ButtonHoverBackground" Color="#1975C5"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="SecondaryButtonHover" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="SecondaryButtonForeground" Color="#111827"/>

        <SolidColorBrush x:Key="ProgressBackground" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ProgressForeground" Color="#0067C0"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SecondaryButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path Data="M0,0 L4,4 L8,0 Z"
                                                  Fill="{DynamicResource TextSecondary}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource InputBackground}"
                                        BorderBrush="{DynamicResource InputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MaxHeight="300"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ProgressBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ProgressForeground}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ProgressForeground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource InputBackground}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBackground}"
                Padding="18"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="robben.png"
                           Width="46"
                           Height="46"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding [AppTitle]}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding [Subtitle]}"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Language]}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextPrimary}"/>

                    <ComboBox x:Name="cmbLanguage"
                              Width="130"
                              SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Deutsch" Tag="de"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Margin="16">

            <TabItem Header="{Binding [TabBackup]}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="540"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="settingsPanel">

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}"
                                                   Text="{Binding [Sources]}"/>

                                        <ListBox x:Name="lstSources"
                                                 Height="130"
                                                 SelectionMode="Extended"
                                                 AllowDrop="True"
                                                 DragOver="Sources_DragOver"
                                                 Drop="Sources_Drop"/>

                                        <TextBlock Text="{Binding [DragDropHint]}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   Margin="0,6,0,8"
                                                   TextWrapping="Wrap"/>

                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="{Binding [AddSource]}"
                                                    Click="AddSource_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding [RemoveSource]}"
                                                    Click="RemoveSource_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding [ClearSources]}"
                                                    Click="ClearSources_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}"
                                                   Text="{Binding [Target]}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="txtTarget"
                                                     Grid.Column="0"
                                                     AllowDrop="True"
                                                     DragOver="Target_DragOver"
                                                     Drop="Target_Drop"
                                                     TextChanged="Target_Changed"/>

                                            <Button Grid.Column="1"
                                                    Content="{Binding [Browse]}"
                                                    Click="BrowseTarget_Click"
                                                    Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}"
                                                   Text="{Binding [Options]}"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding [Preset]}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <ComboBox x:Name="cmbPreset"
                                                      Grid.Column="1"
                                                      Margin="8,0,0,0"
                                                      SelectionChanged="Preset_SelectionChanged">
                                                <ComboBoxItem Content="{Binding [PresetSimple]}" Tag="Simple"/>
                                                <ComboBoxItem Content="{Binding [PresetMirror]}" Tag="Mirror"/>
                                                <ComboBoxItem Content="{Binding [PresetOnlyNewer]}" Tag="OnlyNewer"/>
                                                <ComboBoxItem Content="{Binding [PresetExternal]}" Tag="External"/>
                                            </ComboBox>
                                        </Grid>

                                        <CheckBox x:Name="chkSubdirs"
                                                  Content="{Binding [IncludeSubdirs]}"
                                                  IsChecked="True"
                                                  Checked="Subdirs_Changed"
                                                  Unchecked="Subdirs_Changed"/>

                                        <CheckBox x:Name="chkEmptyDirs"
                                                  Content="{Binding [IncludeEmptyDirs]}"
                                                  IsChecked="True"
                                                  Checked="Options_Changed"
                                                  Unchecked="Options_Changed"/>

                                        <CheckBox x:Name="chkMirror"
                                                  Content="{Binding [Mirror]}"
                                                  Checked="Mirror_Changed"
                                                  Unchecked="Mirror_Changed"/>

                                        <CheckBox x:Name="chkNoOverwrite"
                                                  Content="{Binding [NoOverwrite]}"
                                                  Checked="NoOverwrite_Changed"
                                                  Unchecked="NoOverwrite_Changed"/>

                                        <CheckBox x:Name="chkOnlyNewer"
                                                  Content="{Binding [OnlyNewer]}"
                                                  Checked="OnlyNewer_Changed"
                                                  Unchecked="OnlyNewer_Changed"/>

                                        <CheckBox x:Name="chkPermissions"
                                                  Content="{Binding [CopyPermissions]}"
                                                  Checked="Options_Changed"
                                                  Unchecked="Options_Changed"/>

                                        <CheckBox x:Name="chkUseSourceSubfolder"
                                                  Content="{Binding [UseSourceSubfolder]}"
                                                  IsChecked="True"
                                                  Checked="Options_Changed"
                                                  Unchecked="Options_Changed"/>

                                        <CheckBox x:Name="chkTestRun"
                                                  Content="{Binding [TestRun]}"
                                                  Checked="Options_Changed"
                                                  Unchecked="Options_Changed"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding [Retries]}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBox x:Name="txtRetries"
                                                     Grid.Column="1"
                                                     Text="1"
                                                     Margin="8,0,16,0"
                                                     TextChanged="RetriesWait_Changed"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding [WaitSeconds]}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBox x:Name="txtWait"
                                                     Grid.Column="3"
                                                     Text="3"
                                                     Margin="8,0,0,0"
                                                     TextChanged="RetriesWait_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}"
                                                   Text="{Binding [CommandPreview]}"/>

                                        <TextBox x:Name="txtCommandPreview"
                                                 Height="105"
                                                 IsReadOnly="True"
                                                 TextWrapping="NoWrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}"
                                                   Text="{Binding [Schedule]}"/>

                                        <CheckBox x:Name="chkScheduleEnabled"
                                                  Content="{Binding [EnableSchedule]}"
                                                  Checked="Schedule_Changed"
                                                  Unchecked="Schedule_Changed"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,6,0,0">
                                            <TextBlock Text="{Binding [ScheduleTime]}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <ComboBox x:Name="cmbHour"
                                                      Width="62"
                                                      SelectionChanged="Schedule_Changed"/>

                                            <TextBlock Text=":"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <ComboBox x:Name="cmbMinute"
                                                      Width="62"
                                                      SelectionChanged="Schedule_Changed"/>

                                            <CheckBox x:Name="chkScheduleDaily"
                                                      Content="{Binding [ScheduleDaily]}"
                                                      IsChecked="True"
                                                      Margin="12,0,0,0"
                                                      Checked="Schedule_Changed"
                                                      Unchecked="Schedule_Changed"/>
                                        </StackPanel>

                                        <TextBlock x:Name="lblNextRun"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="0,6,0,0"/>

                                        <TextBlock Text="{Binding [ScheduleHint]}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}"
                                                   Text="{Binding [Profiles]}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding [ProfileName]}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimary}"/>

                                            <TextBox x:Name="txtProfileName"
                                                     Grid.Column="1"
                                                     Margin="8,0,0,0"/>
                                        </Grid>

                                        <ComboBox x:Name="cmbProfiles"
                                                  Margin="0,8,0,8"
                                                  SelectionChanged="Profiles_SelectionChanged"
                                                  MouseDoubleClick="Profiles_MouseDoubleClick"/>

                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="{Binding [SaveProfile]}"
                                                    Click="SaveProfile_Click"
                                                    Margin="0,0,8,0"/>

                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding [NewProfile]}"
                                                    Click="NewProfile_Click"
                                                    Margin="0,0,8,0"/>

                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding [DeleteProfile]}"
                                                    Click="DeleteProfile_Click"
                                                    Margin="0,0,8,0"/>

                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding [ExportTask]}"
                                                    Click="ExportTask_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="btnStart"
                                    Content="{Binding [Start]}"
                                    Click="Start_Click"
                                    Width="150"
                                    Height="42"
                                    FontSize="15"/>

                            <Button x:Name="btnCancel"
                                    Content="{Binding [Cancel]}"
                                    Click="Cancel_Click"
                                    Width="120"
                                    Height="42"
                                    Margin="10,0,0,0"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}"
                                Grid.Row="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}"
                                           Text="{Binding [Progress]}"/>

                                <TextBlock Text="{Binding [OverallProgress]}"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <ProgressBar x:Name="progressOverall"
                                             Height="20"/>

                                <TextBlock Text="{Binding [CurrentFileProgress]}"
                                           Margin="0,10,0,4"
                                           Foreground="{DynamicResource TextPrimary}"/>

                                <ProgressBar x:Name="progressCurrent"
                                             Height="14"/>

                                <TextBlock x:Name="lblStatus"
                                           Text="{Binding [Ready]}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}"
                                Grid.Row="1"
                                Margin="0,12,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource H2}"
                                               Text="{Binding [Log]}"
                                               Margin="0"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <CheckBox x:Name="chkAutoLog"
                                                  Content="{Binding [AutoLog]}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"/>

                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="{Binding [OpenLogFolder]}"
                                                Click="OpenLogFolder_Click"
                                                Margin="8,0,0,0"/>

                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="{Binding [SaveLog]}"
                                                Click="SaveLog_Click"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBox x:Name="txtLog"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         TextWrapping="NoWrap"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding [TabHistory]}">
                <Border Style="{StaticResource Card}"
                        Margin="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,10">
                            <Button Content="{Binding [ClearHistory]}"
                                    Click="ClearHistory_Click"
                                    Margin="0,0,8,0"/>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="{Binding [OpenLogFolder]}"
                                    Click="OpenLogFolder_Click"/>
                        </StackPanel>

                        <DataGrid x:Name="historyGrid"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  SelectionMode="Single"/>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="{Binding [TabSettings]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}"
                                           Text="{Binding [SettingsAppearance]}"/>

                                <CheckBox x:Name="chkDarkMode"
                                          Content="{Binding [DarkMode]}"
                                          Checked="Theme_Changed"
                                          Unchecked="Theme_Changed"/>

                                <CheckBox x:Name="chkMinimizeToTray"
                                          Content="{Binding [MinimizeToTray]}"
                                          IsChecked="True"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}"
                                           Text="{Binding [SettingsEmail]}"/>

                                <CheckBox x:Name="chkEmailEnabled"
                                          Content="{Binding [EmailEnabled]}"/>

                                <Grid Margin="0,8,0,0"
                                      IsEnabled="{Binding IsChecked, ElementName=chkEmailEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [SmtpHost]}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSmtpHost" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [SmtpPort]}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSmtpPort" Grid.Row="1" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [SmtpUser]}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtSmtpUser" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [SmtpPassword]}" VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="txtSmtpPassword" Grid.Row="3" Grid.Column="1" Margin="0,3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [EmailFrom]}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtEmailFrom" Grid.Row="4" Grid.Column="1" Margin="0,3"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [EmailTo]}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtEmailTo" Grid.Row="5" Grid.Column="1" Margin="0,3"/>

                                    <CheckBox x:Name="chkEmailUseSsl"
                                              Grid.Row="6"
                                              Grid.Column="1"
                                              Content="{Binding [EmailUseSsl]}"
                                              IsChecked="True"
                                              Margin="0,6,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="{Binding [SaveSettings]}"
                                Click="SaveSettings_Click"
                                HorizontalAlignment="Left"
                                Width="180"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>